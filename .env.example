# LLM providers (at least one needed for LLM analysts; without any key the
# system falls back to the offline rule-based analysts)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Trading212 (only needed when mode=live)
# Key-pair auth (beta API): TRADING212_API_SECRET optional for legacy single-key.
# TRADING212_ACCOUNT_DEMO=1 → practice/demo account (recommended first!)
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ACCOUNT_DEMO=0

# Market data providers (free tier keys)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optional overrides
# TPM_PORT=8790
# TPM_DB_PATH=data/trading.db
